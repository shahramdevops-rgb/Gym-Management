<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests. Referencing Gym.Api brings the whole assembly graph into the test
    output, which is what the layer dependency tests need.
    Testcontainers, Respawn and WebApplicationFactory arrive in task 0.6.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gym.Api\Gym.Api.csproj" />
  </ItemGroup>

  <!--
    FakeTimeProvider drives the audit interceptor's clock. CLAUDE.md forbids DateTime.UtcNow
    precisely so that tests can pin "now" instead of asserting on a moving target.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <!--
    The database harness. WebApplicationFactory (Mvc.Testing) boots the real Program.cs in
    process, Testcontainers gives it a throwaway postgres:18 of its own — never the
    docker-compose container, so running tests cannot touch development data — and Respawn
    truncates between tests, which is far cheaper than a fresh container or fresh migrations.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Respawn" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

</Project>
