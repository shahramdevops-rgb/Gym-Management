<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The innermost layer. It has no ProjectReference and no PackageReference, and it must stay
    that way: entities and domain rules depend on nothing, not even EF Core.
    tests/Gym.Domain.Tests/Architecture/DomainDependencyTests.cs enforces this.
  -->

  <ItemGroup>
    <!-- PasswordPolicy's blocklist, read by CommonPasswords. A file in the assembly, not a package. -->
    <EmbeddedResource Include="Auth\CommonPasswords.txt" LogicalName="Gym.Domain.Auth.CommonPasswords.txt" />
  </ItemGroup>

</Project>
