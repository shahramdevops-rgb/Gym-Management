<Project Sdk="Microsoft.NET.Sdk">

  <!-- EF Core, Identity, SMS, jobs. Implements the interfaces Application declares. -->
  <ItemGroup>
    <ProjectReference Include="..\Gym.Application\Gym.Application.csproj" />
  </ItemGroup>

  <!--
    The only project that names Postgres. EFCore.NamingConventions maps PascalCase CLR names
    to snake_case database names; the health check package supplies AddDbContextCheck<T>().
  -->
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <!-- Phone number parsing and validation (LibPhoneNumberNormalizer). -->
  <ItemGroup>
    <PackageReference Include="libphonenumber-csharp" />
  </ItemGroup>

  <!-- Issues the JWT access token (JwtAccessTokenIssuer). Gym.Api validates it. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
