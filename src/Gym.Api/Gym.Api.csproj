<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      Identifies this project's user-secrets store (~/AppData/Roaming/Microsoft/UserSecrets/<id>
      on Windows). The store lives outside the repository, so secrets cannot be committed
      by accident. Development only: production reads environment variables.
    -->
    <UserSecretsId>e20a461a-0a35-47f6-b3e7-1d1e139b241c</UserSecretsId>
  </PropertyGroup>

  <!--
    The composition root: it is the only project allowed to reference Infrastructure,
    because it is the only place that wires implementations to interfaces.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Gym.Application\Gym.Application.csproj" />
    <ProjectReference Include="..\Gym.Infrastructure\Gym.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    The mapping tables in ResultExtensions are internal: they are an implementation detail of
    ToHttpResult, not something an endpoint should call. Tests still need to walk them, and
    widening them to public to make a test compile would be letting the test dictate the API.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Gym.Api.IntegrationTests" />
  </ItemGroup>

  <!--
    Design-time only: the `dotnet ef` commands in CLAUDE.md pass this project as the
    startup project, so the tooling builds the host here to find AppDbContext.
    PrivateAssets="all" keeps the scaffolding code out of the published output.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Logging and API documentation are hosting concerns, so they stop here. The inner layers
    log through ILogger<T> and never reference Serilog.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
  </ItemGroup>

  <!-- Validates the JWT access token on every request. Gym.Infrastructure issues it. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
