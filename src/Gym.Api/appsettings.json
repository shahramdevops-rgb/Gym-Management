{
  // Serilog replaces the built-in logger, so levels live here rather than under "Logging".
  // Sinks and levels are configuration, not code, so production can be turned up to Debug
  // for an hour without a rebuild and a redeploy.
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // The framework logs one line per request at Information and several more besides;
        // UseSerilogRequestLogging already emits a single enriched summary line, so these are
        // turned down to avoid logging the same request three times.
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    // Keyed rather than a JSON array. Configuration files merge by key, and arrays merge by
    // index, so an array here would mean appsettings.Development.json could only add a sink
    // by counting entries in this file. With names, Development just adds "Seq".
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          // Logs are for engineers, so they are formatted invariantly. This project disables
          // InvariantGlobalization so the app can handle Persian dates and digits; without
          // this, a machine whose culture is fa-IR would write log timestamps and numbers in
          // Persian digits and no log query would match them.
          "formatProvider": "System.Globalization.CultureInfo::InvariantCulture"
        }
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      // Tags every event, so one Seq instance can serve more than one application.
      "Application": "Gym.Api"
    }
  },
  "Gym": {
    // BUSINESS_RULES.md §0. Numbers typed without a country code are Iranian ("0912…" becomes
    // "+98912…"), and only Iranian mobile numbers are accepted for members.
    "PhoneDefaultRegion": "IR",
    // Defines "today" for every business date: expiry, where a new subscription starts.
    "TimeZone": "Asia/Tehran",
    // Total days a subscription can be frozen, added up over every freeze (task 4.3).
    "MaxFreezeDaysPerSubscription": 30
  },
  "Jwt": {
    // Written into every token and checked on every request, so a token minted for another
    // application with the same key is still refused. Not secrets.
    // Jwt:SigningKey IS a secret and never appears in these files: user-secrets locally,
    // the Jwt__SigningKey environment variable in production.
    "Issuer": "gym-api",
    "Audience": "gym-web"
  },
  "RateLimiting": {
    // BUSINESS_RULES.md §1: 10 login attempts per minute per IP address.
    "Login": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  },
  "AllowedHosts": "*"
}
