{
  // Serilog replaces the built-in logger, so levels live here rather than under "Logging".
  // Sinks and levels are configuration, not code, so production can be turned up to Debug
  // for an hour without a rebuild and a redeploy.
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        // The framework logs one line per request at Information and several more besides;
        // UseSerilogRequestLogging already emits a single enriched summary line, so these are
        // turned down to avoid logging the same request three times.
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    // Keyed rather than a JSON array. Configuration files merge by key, and arrays merge by
    // index, so an array here would mean appsettings.Development.json could only add a sink
    // by counting entries in this file. With names, Development just adds "Seq".
    "WriteTo": {
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          // Logs are for engineers, so they are formatted invariantly. This project disables
          // InvariantGlobalization so the app can handle Persian dates and digits; without
          // this, a machine whose culture is fa-IR would write log timestamps and numbers in
          // Persian digits and no log query would match them.
          "formatProvider": "System.Globalization.CultureInfo::InvariantCulture"
        }
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      // Tags every event, so one Seq instance can serve more than one application.
      "Application": "Gym.Api"
    }
  },
  "AllowedHosts": "*"
}
