# Copy this file to .env and fill in the values. .env is git-ignored and never committed.
# These variables configure the local containers in docker-compose.yml only.

# Postgres. POSTGRES_USER and POSTGRES_DB must match the connection string in
# src/Gym.Api/appsettings.Development.json; POSTGRES_PASSWORD must match the
# "Postgres:Password" user-secret. See the README.
POSTGRES_DB=gym
POSTGRES_USER=gym
POSTGRES_PASSWORD=

# Host ports. Change these if something already listens on them.
POSTGRES_PORT=5432
SEQ_UI_PORT=8081
SEQ_INGESTION_PORT=5341
