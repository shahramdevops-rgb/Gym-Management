{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  // Not used by the compiler (the references do the work). The shadcn CLI reads the alias from
  // this file; without it, `npx shadcn add` writes into a literal ./@ folder.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  }
}
