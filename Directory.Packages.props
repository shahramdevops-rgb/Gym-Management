<Project>

  <!--
    Central Package Management: versions live here, .csproj files reference packages by name only.
    Two projects can therefore never disagree about which version of a package they use.
    Add a row here when a roadmap task introduces a package from the approved list in
    docs/ARCHITECTURE.md.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    EF Core 10. The Application layer references Microsoft.EntityFrameworkCore only for its
    abstractions (IAppDbContext exposes DbSet<T> and SaveChangesAsync); the provider is
    referenced by Infrastructure alone, so Application still knows nothing about Postgres.
    Microsoft.EntityFrameworkCore.Design lives on Gym.Api because it is the startup project
    the `dotnet ef` commands in CLAUDE.md point at.
  -->
  <ItemGroup Label="Persistence">
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!--
    FluentValidation lives in Gym.Application because validators are part of a use case's
    contract, not of HTTP: the same rules must hold when a command arrives from a background
    job. The DependencyInjectionExtensions package only adds AddValidatorsFromAssembly on top
    of Microsoft.Extensions.DependencyInjection.Abstractions, so Application still references
    no ASP.NET Core assembly (a layer dependency test enforces that).
  -->
  <ItemGroup Label="Validation">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <!-- AddDbContextCheck<T>(): the /health endpoint verifies the database, not just the process. -->
  <ItemGroup Label="Diagnostics">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <!--
    Structured logging. Serilog.AspNetCore brings the hosting integration and the console
    sink; Serilog.Sinks.Seq ships events to the Seq container from docker-compose.yml.
    Both are referenced by Gym.Api alone: the other layers log through Microsoft.Extensions
    .Logging abstractions and never learn which logger is behind them.
  -->
  <ItemGroup Label="Logging">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

  <!--
    Microsoft.AspNetCore.OpenApi produces the OpenAPI document; Scalar renders it. Swashbuckle
    is no longer shipped by the ASP.NET Core templates in .NET 9+, and Scalar is the
    replacement UI the templates point at.
  -->
  <ItemGroup Label="ApiDocs">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.4" />
  </ItemGroup>

  <!--
    xunit.v3 carries its own Microsoft Testing Platform runner, so neither
    Microsoft.NET.Test.Sdk nor xunit.runner.visualstudio is needed: the .NET 10 SDK has
    dropped VSTest support for Microsoft.Testing.Platform. The opt-in is the "test" section
    of global.json at the repo root.
  -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

</Project>
