# Production settings for docker-compose.prod.yml. On the server this becomes /opt/gym/.env,
# mode 600, owned by the user you deploy as (docker compose reads it as that user, and a
# release rewrites the TAG line below). Never commit the filled-in copy.
#
# Every value below is required unless it has a default written after it.

# The public name Caddy gets a certificate for. Its A record must point at this server.
DOMAIN=gym.example.ir

# Optional. A second domain you own, permanently redirected to DOMAIN. It needs its own A
# record, because Caddy gets a certificate for it too. Leave it out and nothing is redirected.
# One canonical name on purpose: the refresh cookie is scoped to a single host, so serving the
# app under both names signs staff out whenever they type the other one.
#REDIRECT_DOMAIN=gym.example.com

# Postgres. The password must be long and random: the database is not reachable from outside
# the Compose network, but the API and this file are the only things that hold it.
POSTGRES_DB=gym
POSTGRES_USER=gym
POSTGRES_PASSWORD=

# Signs every access token. At least 32 random bytes, for example: openssl rand -base64 48
# Changing it signs every user out.
JWT_SIGNING_KEY=

# The first Owner account, created at startup only while no Owner exists yet. Change the
# password at the first login; the app forces it. Must satisfy the password policy.
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=

# Which release to run. The deploy script rewrites this line; the previous tag stays on the
# server. This is why the file has to be owned by the user you deploy as.
TAG=latest

# The Compose network. The API trusts X-Forwarded-For only from inside it, so it is pinned
# rather than picked by Docker. Change it only if the server already uses this range
# (`docker network inspect` on an "Pool overlaps" error at startup).
GYM_SUBNET=172.28.0.0/24

# Memory. These are the defaults, sized for a 2 GB server. On a 4 GB server use, for example:
#   POSTGRES_SHARED_BUFFERS=512MB  POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
#   POSTGRES_MEM_LIMIT=1536m       API_MEM_LIMIT=768m
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_MEM_LIMIT=768m
API_MEM_LIMIT=512m
CADDY_MEM_LIMIT=128m
