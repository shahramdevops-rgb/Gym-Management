# Four names, three jobs. {$DOMAIN}, {$PUBLIC_DOMAIN} and {$REDIRECT_DOMAIN} come from the
# environment (docker-compose.prod.yml). A real domain gets a Let's Encrypt certificate
# automatically; "localhost" gets one from Caddy's own local CA, which is how the stack is
# smoke-tested on a development machine.
#
#   {$DOMAIN}           panel.example.ir   the application, and nothing else
#   {$PUBLIC_DOMAIN}    example.ir         the gym's public page: static files, no API
#   www.{$PUBLIC_DOMAIN}                   redirects to the public page
#   {$REDIRECT_DOMAIN}  example.com        redirects to the public page
#
# The panel is on its own host rather than a path under the public one. The refresh cookie is
# scoped to a single host, so this keeps it off the public page entirely; the panel can be given
# its own rate limits or an allowlist without touching the public site; the public site is static
# files that keep serving while the API is down; and only the panel is told not to be indexed.
# That is separation, not security — the login rate limit, lockout, fail2ban and the firewall are
# what actually protect the application.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# A staff login form has no business in a search index. This is tidiness, not a defence:
		# it asks well-behaved crawlers to stay away and stops nobody else.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# The API. Anything under /api that does not exist is the API's 404, not the SPA's page.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Mapped at the API root, not under /api (docs/ARCHITECTURE.md).
	handle /health {
		reverse_proxy api:8080
	}

	# The React build. Not a public path to /hangfire, /openapi or /scalar: those exist only
	# in Development, and nothing here proxies them.
	handle {
		root * /srv

		# File names under /assets carry a content hash, so they can be cached forever.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# index.html names those hashed files, so a browser must ask again after each release.
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"

		# Client-side routes (/members/123) are not files: hand them to the SPA.
		try_files {path} /index.html
		file_server
	}
}

# The gym's public face. One static file and its font, served without touching the API, so a
# release or a database outage never takes the gym's website down with it.
# Unset (local smoke tests) it falls back to a single-label name, which keeps Caddy on its
# internal CA instead of asking Let's Encrypt for an unobtainable certificate.
{$PUBLIC_DOMAIN:no-public-site} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	root * /srv-public
	file_server
}

# www and the second domain are not second homes: they point at the public page. A visitor who
# types either of them is a member of the public, not a member of staff, so neither is sent to
# the panel's login form.
www.{$PUBLIC_DOMAIN:no-public-site}, {$REDIRECT_DOMAIN:no-redirect} {
	redir https://{$PUBLIC_DOMAIN:no-public-site}{uri} permanent
}
